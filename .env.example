# Copy this file to .env and fill in the values for your own Supabase project.
# Never commit .env — it is ignored by git.
#
# Both values are safe to expose in the browser bundle ONLY when Row Level
# Security is enabled on every table. Until then, treat them as secrets.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
